{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/submit", "destination": "/api/submit" },
    { "source": "/", "destination": "/home" }
  ],
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/home12", "destination": "/", "permanent": true },
    { "source": "/oldhome", "destination": "/", "permanent": true },
    { "source": "/ig", "destination": "/move", "permanent": false },
    { "source": "/quiz", "destination": "/move", "permanent": true },
    { "source": "/buyer-quiz", "destination": "/move", "permanent": true },
    { "source": "/sellerguide", "destination": "/seller", "permanent": true },
    { "source": "/buyerguide", "destination": "/buyer", "permanent": true },
    { "source": "/equityreport", "destination": "/valuation", "permanent": true },
    { "source": "/helpmemove", "destination": "/zoom", "permanent": true },
    { "source": "/contact", "destination": "/zoom", "permanent": true },
    { "source": "/contact2", "destination": "/zoom", "permanent": true },
    { "source": "/connect", "destination": "/zoom", "permanent": true },
    { "source": "/es", "destination": "/", "permanent": false },
    { "source": "/es/", "destination": "/", "permanent": false },
    { "source": "/es/:path*", "destination": "/", "permanent": false },
    { "source": "/gallery", "destination": "/buyer", "permanent": true },
    { "source": "/property", "destination": "/buyer", "permanent": true },
    { "source": "/listings", "destination": "/buyer", "permanent": true },
    { "source": "/resume", "destination": "/about", "permanent": true },
    { "source": "/insights/bilingual-realtor-downey", "destination": "/real-estate-agent-downey", "permanent": true },
    { "source": "/best-bilingual-realtor-anaheim", "destination": "/neighborhoods/anaheim", "permanent": true },
    { "source": "/best-bilingual-realtor-bellflower", "destination": "/neighborhoods/bellflower", "permanent": true },
    { "source": "/best-bilingual-realtor-cerritos", "destination": "/neighborhoods/cerritos", "permanent": true },
    { "source": "/best-bilingual-realtor-downey", "destination": "/real-estate-agent-downey", "permanent": true },
    { "source": "/best-bilingual-realtor-garden-grove", "destination": "/neighborhoods/garden-grove", "permanent": true },
    { "source": "/best-bilingual-realtor-la-mirada", "destination": "/neighborhoods/la-mirada", "permanent": true },
    { "source": "/best-bilingual-realtor-lakewood", "destination": "/neighborhoods/lakewood", "permanent": true },
    { "source": "/best-bilingual-realtor-long-beach", "destination": "/neighborhoods/long-beach", "permanent": true },
    { "source": "/best-bilingual-realtor-manhattan-beach", "destination": "/neighborhoods/manhattan-beach", "permanent": true },
    { "source": "/best-bilingual-realtor-montebello", "destination": "/neighborhoods/montebello", "permanent": true },
    { "source": "/best-bilingual-realtor-norwalk", "destination": "/neighborhoods/norwalk", "permanent": true },
    { "source": "/best-bilingual-realtor-pasadena", "destination": "/neighborhoods/pasadena", "permanent": true },
    { "source": "/best-bilingual-realtor-pico-rivera", "destination": "/neighborhoods/pico-rivera", "permanent": true },
    { "source": "/best-bilingual-realtor-santa-ana", "destination": "/neighborhoods/santa-ana", "permanent": true },
    { "source": "/best-bilingual-realtor-whittier", "destination": "/neighborhoods/whittier", "permanent": true }
  ],
  "crons": [
    {
      "path": "/api/rates",
      "schedule": "0 16 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400, must-revalidate" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400, must-revalidate" }
      ]
    },
    {
      "source": "/(sitemap\\.xml|robots\\.txt|manifest\\.json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
